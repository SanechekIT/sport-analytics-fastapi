from pydantic import BaseModel

class MealItemBase(BaseModel):
    product_id: int
    quantity: float  # сколько грамм/штук

class MealItemCreate(MealItemBase):
    pass

class MealItem(MealItemBase):
    id: int
    meal_id: int
    # Добавляю посчитанные КБЖУ для удобства фронта
    product_name: str
    calories: float
    proteins: float
    fats: float
    carbs: float
